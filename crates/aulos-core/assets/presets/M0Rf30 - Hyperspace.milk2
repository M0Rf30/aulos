shapecode_3_border_a=0
shape_3_per_frame1=
per_frame_1=dt = min(max(time-tl,0.004),0.1); tl = time;
per_frame_2=bm = bm + (bass-bm)*(1-exp(-dt/0.8)); bd = bd + (abs(bass-bm)-bd)*(1-exp(-dt/2.5));
per_frame_3=hit = min(max(((bass-bm)/max(bd,0.1) - 0.8)/1.5, 0), 1);
per_frame_4=kick = max(kick*pow(0.86, 60*dt), hit);
per_frame_5=trig = above(kick, 0.55)*above(time, tb+0.3); tb = trig*time + (1-trig)*tb;
per_frame_6=nk = nk + trig; jmp = trig*equal(nk - 8*int(nk/8), 0);
per_frame_7=jump = max(jump*pow(0.975, 60*dt), jmp);
per_frame_8=thr = max(thr*pow(0.972, 60*dt), kick);
per_frame_9=ringt = trig*0 + (1-trig)*(ringt+dt);
per_frame_10=k1 = 1-pow(0.97,60*dt); sb = sb + (bass_att-sb)*k1; sm = sm + (mid_att-sm)*k1; st = st + (treb_att-st)*k1;
per_frame_11=g = 0.75 + 0.25*min(sb,2) + 3.0*thr + 4.5*jump;
per_frame_12=zf = exp(g*dt);
per_frame_13=zacc = zacc + g*dt; zacc = zacc - 102.4*above(zacc,102.4);
per_frame_14=sg = if(above(rand(100),50),1,-1); sg2 = if(above(rand(100),50),1,-1);
per_frame_15=wv = wv*pow(0.955,60*dt) + trig*sg*0.55 + jmp*sg*1.4;
per_frame_16=om = 0.2*sin(time*0.31)*sin(time*0.13+1) + 0.05*sin(time*0.7) + wv;
per_frame_17=racc = racc + om*dt;
per_frame_18=kap = max(min(om/max(g,0.5), 0.32), -0.32);
per_frame_19=vx = vx + trig*sg*(0.8+rand(100)*0.01) + jmp*sg2*1.6; vy = vy + trig*sg2*(0.6+rand(100)*0.008);
per_frame_20=sd = min(dt,0.025); vx = vx + (-70*ox - 8*vx)*sd; vy = vy + (-70*oy - 8*vy)*sd; ox = ox + vx*sd; oy = oy + vy*sd;
per_frame_21=cxo = cxn; cyo = cyn;
per_frame_22=cxn = 0.5 + 0.11*sin(time*0.31) + 0.05*sin(time*0.83+1) + ox + 0.006*kick*sin(time*71);
per_frame_23=cyn = 0.5 + 0.08*sin(time*0.27+0.6) + 0.04*sin(time*0.91) + oy + 0.006*kick*sin(time*83);
per_frame_24=cxn = min(max(cxn,0.2),0.8); cyn = min(max(cyn,0.22),0.78);
per_frame_25=q1 = kick; q2 = zacc; q3 = thr; q4 = g; q5 = sb; q6 = 0.03 + ringt*0.9; q7 = exp(-ringt*3.0);
per_frame_26=q8 = cxn; q9 = cyn; q10 = racc; q11 = st; q12 = sm; q13 = pow(0.945, 60*dt);
per_frame_27=q14 = cxo; q15 = cyo; q16 = 6.2831853*om*dt; q17 = zf; q18 = kap; q19 = jump;
per_frame_28=monitor = kick;
warp_1=`shader_body
warp_2=`{
warp_3=`  float ar = texsize.x*texsize.w;
warp_4=`  float2 asp = float2(ar, 1.0);
warp_5=`  float2 pn = (uv_orig - float2(q8, q9))*asp;
warp_6=`  float cs = cos(q16);
warp_7=`  float sn = sin(q16);
warp_8=`  float2 po = float2(cs*pn.x - sn*pn.y, sn*pn.x + cs*pn.y)/q17;
warp_9=`  float2 so = float2(q14, q15) + po/asp;
warp_10=`  float3 prev = tex2D(sampler_main, so).rgb;
warp_11=`  prev = lerp(prev, GetBlur1(so), 0.22);
warp_12=`  float2 p = pn;
warp_13=`  float r = max(length(p), 0.0005);
warp_14=`  float u = log(r) - q2;
warp_15=`  float a = atan2(p.y,p.x)*0.1591549 + 0.5 + q10 + q18*u;
warp_16=`  float n1 = tex2Dlod(sampler_noise_hq, float4(a*13.0, u*0.625, 0, 0)).x;
warp_17=`  float n2 = tex2Dlod(sampler_noise_hq, float4(a*29.0+0.37, u*1.25, 0, 0)).y;
warp_18=`  float n3 = tex2Dlod(sampler_noise_hq, float4(a*61.0+0.71, u*2.5, 0, 0)).z;
warp_19=`  float f = 0.5*n1 + 0.32*n2 + 0.18*n3;
warp_20=`  float rib = pow(smoothstep(0.52, 0.86, f), 1.6);
warp_21=`  float hue = tex2Dlod(sampler_noise_hq, float4(a*5.0, u*0.3125, 0, 0)).w;
warp_22=`  float3 cA = float3(0.10, 0.45, 1.00);
warp_23=`  float3 cB = float3(0.20, 0.30, 1.00);
warp_24=`  float3 cC = float3(1.00, 0.25, 0.80);
warp_25=`  float3 col = lerp(lerp(cA, cB, smoothstep(0.2,0.6,hue)), cC, smoothstep(0.7,0.95,hue));
warp_26=`  float env = exp(-r*1.9)*smoothstep(0.004, 0.06, r);
warp_27=`  float3 inj = col*rib*env*(0.9 + 1.4*q1 + 0.5*q11 + 2.0*q19);
warp_28=`  ret = prev*q13 + inj*0.045;
warp_29=`  ret = max(ret - 0.002, 0.0);
warp_30=`}
comp_1=`shader_body
comp_2=`{
comp_3=`  float ar = texsize.x*texsize.w;
comp_4=`  float2 p = (uv-0.5)*float2(ar,1) - float2((q8-0.5)*ar, q9-0.5);
comp_5=`  float r = max(length(p), 0.0005);
comp_6=`  float a = atan2(p.y,p.x)*0.1591549;
comp_7=`  float u = log(r) - q2;
comp_8=`  float2 ca = p/r*0.0045*r*(1.0+1.2*q3);
comp_9=`  ca = float2(ca.x/ar, ca.y);
comp_10=`  float3 c;
comp_11=`  c.r = tex2D(sampler_main, uv + ca).r;
comp_12=`  c.g = tex2D(sampler_main, uv).g;
comp_13=`  c.b = tex2D(sampler_main, uv - ca).b;
comp_14=`  float3 b1 = GetBlur1(uv);
comp_15=`  float3 b2 = GetBlur2(uv);
comp_16=`  float3 b3 = GetBlur3(uv);
comp_17=`  float3 col = c*1.25 + b1*0.12 + b2*0.12 + b3*0.12;
comp_18=`  float3 st = float3(0,0,0);
comp_19=`  float disp = 0.003 + 0.016*r*(0.6 + 0.8*q3);
comp_20=`  float3 us = u + float3(-1.0, 0.0, 1.0)*disp;
comp_21=`  float Lu = min(0.04 + 0.05*q4, 0.36);
comp_22=`  float fade = smoothstep(0.012, 0.28, r)*(1.0 + 1.3*q1);
comp_23=`  for (int i = 0; i < 4; i++)
comp_24=`  {
comp_25=`    float fi = float(i);
comp_26=`    float N = 44.0 + 30.0*fi;
comp_27=`    float sx = frac(a + q10 + q18*u + 0.5 + 0.13*fi)*N;
comp_28=`    float ids = floor(sx);
comp_29=`    float fs = frac(sx);
comp_30=`    float uo = 0.37*fi;
comp_31=`    float cu = floor((u + uo)/0.4);
comp_32=`    for (int k = 0; k < 2; k++)
comp_33=`    {
comp_34=`      float cell = cu + float(k);
comp_35=`      float4 rn = tex2Dlod(sampler_pw_noise_lq, float4((float2(ids + 53.0*fi, cell) + 0.5)/256.0, 0, 0));
comp_36=`      float on = step(0.42 + 0.06*fi, rn.r);
comp_37=`      float hv = (cell + rn.b)*0.4 - uo;
comp_38=`      float3 dd = hv - us;
comp_39=`      float3 along = lerp(exp(dd*55.0), pow(saturate(1.0 - dd/Lu), 2.0), step(0.0, dd)) + 0.9*exp(-dd*dd*6000.0);
comp_40=`      float tp = (fs - (0.2 + 0.6*rn.g))*6.2831853*r/N;
comp_41=`      float wd = (0.0007 + 0.0014*r)*(0.7 + 0.9*rn.a);
comp_42=`      float across = exp(-tp*tp/(wd*wd));
comp_43=`      float s = rn.a;
comp_44=`      float3 sc = lerp(float3(0.35,0.85,1.0), float3(1.0,1.0,1.0), saturate(s*2.0));
comp_45=`      sc = lerp(sc, float3(1.0,0.35,0.9), saturate(s*2.0 - 1.0));
comp_46=`      st += on*sc*along*across*(0.4 + 1.5*s*s);
comp_47=`    }
comp_48=`  }
comp_49=`  col += st*fade*1.5;
comp_50=`  float2 q = float2(p.x, p.y);
comp_51=`  float core = exp(-r*7.0)*0.5 + exp(-r*28.0)*0.9 + exp(-r*95.0)*1.3;
comp_52=`  float3 cc = lerp(float3(0.25,0.55,1.0), float3(0.85,0.95,1.0), saturate(exp(-r*22.0)*1.4));
comp_53=`  float fl = exp(-abs(q.y)*70.0)*exp(-abs(q.x)*2.4)*0.8 + exp(-abs(q.x)*90.0)*exp(-abs(q.y)*4.0)*0.12;
comp_54=`  col += cc*core*(0.45 + 0.9*q1 + 0.25*q3) + float3(0.35,0.65,1.0)*fl*(0.35 + q1);
comp_55=`  float rr = (r - q6)*70.0;
comp_56=`  col += float3(0.6,0.85,1.0)*exp(-rr*rr)*q7*0.45;
comp_57=`  col += float3(0.5,0.8,1.0)*q19*exp(-r*2.5)*0.8;
comp_58=`  col = 1.0 - exp(-col*1.15);
comp_59=`  float lw = dot(col, float3(0.3,0.59,0.11));
comp_60=`  col = lerp(float3(lw,lw,lw), col, 1.25);
comp_61=`  col = lerp(col, col*col*(3.0 - 2.0*col), 0.55);
comp_62=`  col = col*float3(0.92, 1.0, 1.08) + float3(0.0, 0.003, 0.012);
comp_63=`  col *= lerp(0.55, 1.0, smoothstep(1.15, 0.25, r));
comp_64=`  ret = saturate(col);
comp_65=`}
[PRESET1_END]

