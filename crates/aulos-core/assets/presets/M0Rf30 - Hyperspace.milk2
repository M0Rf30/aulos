shapecode_3_a2=0
shapecode_3_border_r=0
shapecode_3_border_g=0
shapecode_3_border_b=0
shapecode_3_border_a=0
shape_3_per_frame1=
per_frame_1=dt = min(max(time-tl,0.004),0.1); tl = time;
per_frame_2=bm = bm + (bass-bm)*(1-exp(-dt/0.8)); bd = bd + (abs(bass-bm)-bd)*(1-exp(-dt/2.5));
per_frame_3=hit = min(max(((bass-bm)/max(bd,0.1) - 0.8)/1.5, 0), 1);
per_frame_4=kick = max(kick*pow(0.86, 60*dt), hit);
per_frame_5=trig = above(kick, 0.55)*above(time, tb+0.3); tb = trig*time + (1-trig)*tb;
per_frame_6=nk = nk + trig; jmp = trig*equal(nk - 6*int(nk/6), 3);
per_frame_7=jump = max(jump*pow(0.975, 60*dt), jmp);
per_frame_8=ringt = trig*0 + (1-trig)*(ringt+dt);
per_frame_9=k1 = 1-pow(0.97,60*dt); sb = sb + (bass_att-sb)*k1; sm = sm + (mid_att-sm)*k1; st = st + (treb_att-st)*k1;
per_frame_10=vel = 0.8 + 0.5*min(sb,2) + 2.0*kick + 5.0*jump;
per_frame_11=vacc = vacc + vel*dt; vacc = vacc - 64*above(vacc,64);
per_frame_12=sg = if(above(rand(100),50),1,-1); sg2 = if(above(rand(100),50),1,-1);
per_frame_13=wv = wv*pow(0.96,60*dt) + trig*sg*0.5 + jmp*sg*1.3;
per_frame_14=om = 0.04*sin(time*0.19) + 0.11*sin(time*0.47+0.7) + wv;
per_frame_15=racc = racc + om*dt;
per_frame_16=twk = twk + (0.12*min(sb,2.5) - twk)*(1-pow(0.99,60*dt));
per_frame_17=vx = vx + trig*sg*(0.8+rand(100)*0.01) + jmp*sg2*1.6; vy = vy + trig*sg2*(0.6+rand(100)*0.008);
per_frame_18=sd = min(dt,0.025); vx = vx + (-70*ox - 8*vx)*sd; vy = vy + (-70*oy - 8*vy)*sd; ox = ox + vx*sd; oy = oy + vy*sd;
per_frame_19=cxo = cxn; cyo = cyn;
per_frame_20=cxn = 0.5 + 0.09*sin(time*0.29) + 0.04*sin(time*0.87+1) + ox + 0.006*kick*sin(time*73);
per_frame_21=cyn = 0.5 + 0.07*sin(time*0.23+0.6) + 0.04*sin(time*0.93) + oy + 0.006*kick*sin(time*79);
per_frame_22=cxn = min(max(cxn,0.2),0.8); cyn = min(max(cyn,0.22),0.78);
per_frame_23=bamp = 0.24 + 0.12*sin(time*0.17) + 0.18*kick + 0.2*jump;
per_frame_24=ph1 = time*0.9 + 2*racc; ph2 = time*0.63 + 2.0;
per_frame_25=q1 = kick; q2 = vacc; q3 = racc; q4 = twk; q5 = sb; q6 = 0.03 + ringt*0.9; q7 = exp(-ringt*3.0);
per_frame_26=q8 = cxn; q9 = cyn; q10 = vel; q11 = st; q12 = sm; q13 = pow(0.935, 60*dt);
per_frame_27=q14 = vel*dt/0.4; q15 = 6.2831853*om*dt; q16 = jump; q17 = ph1; q18 = ph2; q19 = bamp;
per_frame_28=q20 = cxo; q21 = cyo;
per_frame_29=monitor = kick;
warp_1=`shader_body
warp_2=`{
warp_3=`  float ar = texsize.x*texsize.w;
warp_4=`  float2 asp = float2(ar, 1.0);
warp_5=`  float2 pn = (uv_orig - float2(q8, q9))*asp;
warp_6=`  float r = max(length(pn), 0.0005);
warp_7=`  float rs = r + 0.012;
warp_8=`  float ro = max(rs/(1.0 + rs*q14) - 0.012, 0.0);
warp_9=`  float2 pr = pn/r*ro;
warp_10=`  float cs = cos(q15);
warp_11=`  float sn = sin(q15);
warp_12=`  float2 po = float2(cs*pr.x - sn*pr.y, sn*pr.x + cs*pr.y);
warp_13=`  float2 so = float2(q20, q21) + po/asp;
warp_14=`  float3 prev = tex2D(sampler_main, so).rgb;
warp_15=`  prev = lerp(prev, GetBlur1(so), 0.2);
warp_16=`  float d = 0.4/rs;
warp_17=`  float a = atan2(pn.y, pn.x)*0.1591549 + 0.5 + q3;
warp_18=`  float3 inj = float3(0, 0, 0);
warp_19=`  for (int i = 0; i < 2; i++)
warp_20=`  {
warp_21=`    float fi = float(i);
warp_22=`    float N = 34.0 + 24.0*fi;
warp_23=`    float sx = frac(a + 0.27*fi)*N;
warp_24=`    float ids = floor(sx);
warp_25=`    float fs = frac(sx);
warp_26=`    float cu = (d - 2.0*q2 + 0.31*fi)/0.5;
warp_27=`    float cell = floor(cu);
warp_28=`    float fc = cu - cell;
warp_29=`    float4 hn = tex2Dlod(sampler_pw_noise_lq, float4((float2(ids + 41.0*fi, cell) + 0.5)/256.0, 0, 0));
warp_30=`    float on = step(0.72, hn.r);
warp_31=`    float ds = (fc - (0.3 + 0.4*hn.b))*0.5;
warp_32=`    float dr = ds*rs*rs/0.4;
warp_33=`    float tp = (fs - (0.25 + 0.5*hn.g))*6.2831853*r/N;
warp_34=`    float sz = 0.0025 + 0.012*r;
warp_35=`    float dot2 = (tp*tp + dr*dr)/(sz*sz);
warp_36=`    float3 sc = lerp(float3(1.0, 0.32, 0.08), float3(1.0, 0.85, 0.45), hn.a);
warp_37=`    inj += sc*exp(-dot2)*on*(0.5 + hn.a);
warp_38=`  }
warp_39=`  inj *= smoothstep(0.03, 0.2, r);
warp_40=`  ret = prev*q13 + inj*(0.5 + 1.2*q1 + 1.5*q16);
warp_41=`  ret = max(ret - 0.002, 0.0);
warp_42=`}
comp_1=`shader_body
comp_2=`{
comp_3=`  float ar = texsize.x*texsize.w;
comp_4=`  float2 asp = float2(ar, 1.0);
comp_5=`  float2 p0 = (uv - float2(q8, q9))*asp;
comp_6=`  float rs0 = length(p0) + 0.012;
comp_7=`  float d0 = 0.4/rs0 - q2;
comp_8=`  float2 bnd = float2(sin(0.4909*d0 + q17) + 0.45*sin(0.8836*d0 + 1.7*q17), sin(0.8836*d0 + q18) + 0.45*cos(0.2945*d0 + q18));
comp_9=`  float2 p = p0 - bnd*q19*rs0;
comp_10=`  float r = max(length(p), 0.0005);
comp_11=`  float d = 0.4/(r + 0.012);
comp_12=`  float dd = d - q2;
comp_13=`  float a = atan2(p.y, p.x)*0.1591549 + 0.5;
comp_14=`  float ae = a + q3 + q4*d*0.5;
comp_15=`  float2 ca = p/r*0.005*r*(1.0 + 1.5*q16 + q1);
comp_16=`  ca = float2(ca.x/ar, ca.y);
comp_17=`  float3 c;
comp_18=`  c.r = tex2D(sampler_main, uv + ca).r;
comp_19=`  c.g = tex2D(sampler_main, uv).g;
comp_20=`  c.b = tex2D(sampler_main, uv - ca).b;
comp_21=`  float3 b1 = GetBlur1(uv);
comp_22=`  float3 b2 = GetBlur2(uv);
comp_23=`  float3 b3 = GetBlur3(uv);
comp_24=`  float f1 = tex2Dlod(sampler_noise_hq, float4(ae*6.0, dd*0.5, 0, 0)).x;
comp_25=`  float2 wp = (f1 - 0.5)*float2(1.4, 1.1);
comp_26=`  float f2 = tex2Dlod(sampler_noise_hq, float4(ae*12.0 + wp.x, dd + wp.y, 0, 0)).y;
comp_27=`  float f3 = tex2Dlod(sampler_noise_hq, float4(ae*24.0 + wp.x*2.0, dd*2.0 + wp.y*2.0, 0, 0)).z;
comp_28=`  float base = 0.5*f1 + 0.32*f2 + 0.18*f3;
comp_29=`  float vein = pow(1.0 - abs(2.0*f2 - 1.0), 7.0);
comp_30=`  float vein2 = pow(1.0 - abs(2.0*f3 - 1.0), 9.0);
comp_31=`  float fa = frac(ae);
comp_32=`  float4 pn = tex2Dlod(sampler_pw_noise_lq, float4((float2(floor(fa*24.0), floor(dd*2.0)) + 0.5)/256.0, 0, 0));
comp_33=`  float lx = abs(frac(fa*24.0) - 0.5)*2.0;
comp_34=`  float lz = abs(frac(dd*2.0) - 0.5)*2.0;
comp_35=`  float grid = smoothstep(0.90, 0.985, max(lx, lz));
comp_36=`  float lit = step(0.78, pn.r)*(0.55 + 0.45*sin(time*2.4 + pn.g*40.0));
comp_37=`  float3 violet = float3(0.05, 0.01, 0.17);
comp_38=`  float3 plum = float3(0.42, 0.07, 0.42);
comp_39=`  float3 ember = float3(0.95, 0.27, 0.05);
comp_40=`  float3 gold = float3(1.0, 0.74, 0.24);
comp_41=`  float3 surf = lerp(violet, plum, smoothstep(0.26, 0.56, base));
comp_42=`  surf = lerp(surf, ember, smoothstep(0.54, 0.78, base));
comp_43=`  surf = lerp(surf, gold, smoothstep(0.84, 0.98, base));
comp_44=`  surf += gold*vein*0.75 + float3(1.0, 0.5, 0.2)*vein2*0.35;
comp_45=`  float gfade = smoothstep(0.03, 0.12, r);
comp_46=`  surf += float3(1.0, 0.42, 0.1)*grid*0.55*gfade + float3(0.45, 0.12, 0.6)*lit*gfade*0.35;
comp_47=`  float light = 0.42 + 1.0*exp(-r*2.7);
comp_48=`  surf *= light;
comp_49=`  float rn = saturate((r - 0.03)*1.25);
comp_50=`  float fx = 0.003*exp(3.8*rn);
comp_51=`  float fv = 1.0 - exp(-0.5*(get_fft(fx) + get_fft(fx*1.25))*(2.0 + 3.0*rn));
comp_52=`  float rf = frac(dd) - 0.5;
comp_53=`  float3 rfv = rf + float3(-1.0, 0.0, 1.0)*0.014*(0.4 + r*(1.0 + q1));
comp_54=`  float w = 0.025 + 0.05*fv;
comp_55=`  float3 ring = exp(-rfv*rfv/(w*w))*(0.2 + 0.9*fv);
comp_56=`  float3 halo = exp(-rfv*rfv/(w*w*10.0))*(0.1 + 0.3*fv);
comp_57=`  float3 rcol = lerp(float3(1.0, 0.48, 0.12), float3(1.0, 0.92, 0.65), saturate(fv*0.9));
comp_58=`  float rfade = smoothstep(0.015, 0.1, r);
comp_59=`  surf += (ring*rcol + halo*float3(0.9, 0.25, 0.4))*rfade*(0.55 + 0.9*light);
comp_60=`  float3 col = surf + c*0.9 + b1*0.1 + b2*0.13 + b3*0.18;
comp_61=`  float pulse = 0.6 + 0.6*q1 + 1.0*q16;
comp_62=`  float core = exp(-r*10.0)*0.2 + exp(-r*38.0)*0.7 + exp(-r*130.0)*1.6;
comp_63=`  float3 cc = lerp(float3(1.0, 0.5, 0.15), float3(1.0, 0.93, 0.75), saturate(exp(-r*30.0)*1.4));
comp_64=`  float pr = (r - 0.05 - 0.012*q1)*75.0;
comp_65=`  float rays = pow(tex2Dlod(sampler_noise_hq, float4(a*9.0 + q3*9.0, time*0.07, 0, 0)).x, 3.0);
comp_66=`  float fl = exp(-abs(p.y)*80.0)*exp(-abs(p.x)*2.6)*0.7;
comp_67=`  col += cc*core*pulse + float3(1.0, 0.72, 0.3)*exp(-pr*pr)*0.55*pulse;
comp_68=`  col += float3(1.0, 0.6, 0.2)*rays*exp(-r*4.5)*(0.5 + 1.5*q1)*smoothstep(0.02, 0.15, r);
comp_69=`  col += float3(1.0, 0.65, 0.25)*fl*(0.2 + 0.6*q1 + 0.6*q16);
comp_70=`  float sr = (r - q6)*60.0;
comp_71=`  col += float3(1.0, 0.8, 0.5)*exp(-sr*sr)*q7*0.6;
comp_72=`  col = 1.0 - exp(-col*1.0);
comp_73=`  float lw = dot(col, float3(0.3, 0.59, 0.11));
comp_74=`  col = lerp(float3(lw, lw, lw), col, 1.2);
comp_75=`  col = lerp(col, col*col*(3.0 - 2.0*col), 0.6);
comp_76=`  col = col*float3(1.05, 0.98, 0.95) + float3(0.025, 0.0, 0.04)*(1.0 - lw);
comp_77=`  col *= lerp(0.72, 1.0, smoothstep(1.2, 0.3, r));
comp_78=`  ret = saturate(col);
comp_79=`}
[PRESET2_END]
