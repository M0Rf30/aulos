comp_94=`  float3 glass = col*sh*(back + 1.3*pulse);
comp_95=`  float2 L = float2(cos(time*0.25), sin(time*0.25));
comp_96=`  float gl = exp(-pow((dot(d1, L) + 0.18)*7.0, 2.0))*smoothstep(0.6, 0.2, v.x);
comp_97=`  glass += float3(1.0, 0.95, 0.85)*gl*0.22*(0.5 + pulse + q1);
comp_98=`  float zr = abs(frac(u/ZROW + 0.5) - 0.5)*ZROW;
comp_99=`  float lead1 = 1.0 - smoothstep(wl - pe, wl + pe, e);
comp_100=`  float lead2 = 1.0 - smoothstep(wl*1.8 - pe, wl*1.8 + pe, zr);
comp_101=`  float lead = max(lead1, lead2);
comp_102=`  float2 nd = -d1/max(length(d1), 0.001);
comp_103=`  float hl = pow(saturate(dot(nd, L)), 3.0);
comp_104=`  float band = smoothstep(0.0, wl*0.5, e)*(1.0 - smoothstep(wl*0.5, wl, e));
comp_105=`  float zb = smoothstep(0.0, wl*0.8, zr)*(1.0 - smoothstep(wl*0.8, wl*1.8, zr));
comp_106=`  float3 lc = float3(0.025, 0.02, 0.03) + hl*band*float3(0.9, 0.72, 0.45)*0.9;
comp_107=`  lc += zb*float3(0.9, 0.68, 0.32)*(0.18 + 0.3*hl);
comp_108=`  return float4(lerp(glass, lc, lead), lead);
comp_109=`}
comp_110=`shader_body
comp_111=`{
comp_112=`  float ar = texsize.x*texsize.w;
comp_113=`  float2 p = (uv - 0.5)*float2(ar, 1.0);
comp_114=`  float r = length(p);
comp_115=`  float2 pr = rot2(p, q2);
comp_116=`  float4 g = rose(pr);
comp_117=`  float3 col = g.rgb;
comp_118=`  float a = atan2(pr.y, pr.x);
comp_119=`  float pc = abs(cos(a*NSEG*0.5));
comp_120=`  float rn0 = r/0.068;
comp_121=`  float3 gem = lerp(float3(0.75, 0.04, 0.10), float3(1.0, 0.62, 0.10), pow(pc, 1.5));
comp_122=`  gem *= 0.35 + 0.9*smoothstep(0.0, 1.0, rn0);
comp_123=`  gem += float3(1.0, 0.85, 0.55)*exp(-rn0*5.0)*(1.1 + 1.8*q1);
comp_124=`  gem *= lerp(0.15, 1.0, smoothstep(0.03, 0.14, pc + 0.2*rn0));
comp_125=`  float gm = smoothstep(0.074, 0.067, r);
comp_126=`  float ring = smoothstep(0.082, 0.078, r)*smoothstep(0.060, 0.067, r);
comp_127=`  col = lerp(col, gem*(1.0 + 0.5*q1), gm);
comp_128=`  col = lerp(col, float3(0.03, 0.02, 0.03) + float3(0.5, 0.35, 0.15)*pow(smoothstep(0.077, 0.080, r)*smoothstep(0.083, 0.080, r), 2.0), ring*(1.0 - gm));
comp_129=`  float2 ca = p/max(r, 0.001)*0.003*r;
comp_130=`  float3 fb;
comp_131=`  fb.r = tex2D(sampler_main, uv + ca).r;
comp_132=`  fb.g = tex2D(sampler_main, uv).g;
comp_133=`  fb.b = tex2D(sampler_main, uv - ca).b;
comp_134=`  float3 b2 = GetBlur2(uv);
comp_135=`  float3 b3 = GetBlur3(uv);
comp_136=`  float3 sh = float3(0, 0, 0);
comp_137=`  for (int k = 0; k < 10; k++)
comp_138=`  {
comp_139=`    float fk = float(k);
comp_140=`    sh += tex2D(sampler_main, 0.5 + (uv - 0.5)*(1.0 - fk*0.05)).rgb*(1.0 - fk*0.09);
comp_141=`  }
comp_142=`  col += fb*0.6 + b2*0.18 + b3*(0.2 + 0.5*q6) + sh*(0.085 + 0.06*q1);
comp_143=`  float3 dust = float3(0, 0, 0);
comp_144=`  for (int i = 0; i < 2; i++)
comp_145=`  {
comp_146=`    float fi = float(i);
comp_147=`    float2 gp = p*(9.0 + 7.0*fi) + float2(fi*3.1, -time*(0.25 + 0.2*fi));
comp_148=`    float2 gid = floor(gp);
comp_149=`    float4 dn = tex2Dlod(sampler_pw_noise_lq, float4((gid + 0.5)/256.0, 0, 0));
comp_150=`    float2 dpos = frac(gp) - 0.5 - (dn.rg - 0.5)*0.5;
comp_151=`    float tw = 0.5 + 0.5*sin(time*(1.5 + 3.0*dn.b) + dn.a*40.0);
comp_152=`    float dr = length(dpos);
comp_153=`    dust += float3(1.0, 0.82, 0.55)*step(0.72, dn.a)*exp(-dr*dr*(260.0 + 400.0*dn.b))*tw*(0.6 + 0.7*q1);
comp_154=`  }
comp_155=`  col += dust*0.7;
comp_156=`  col *= 1.0 + 0.55*q1 + 0.25*q6;
comp_157=`  col = 1.0 - exp(-col*1.1);
comp_158=`  float l = dot(col, float3(0.3, 0.59, 0.11));
comp_159=`  col = lerp(float3(l, l, l), col, 1.3);
comp_160=`  col = saturate(col);
comp_161=`  col *= lerp(0.40, 1.0, smoothstep(1.15, 0.35, r));
comp_162=`  ret = col;
comp_163=`}
[PRESET1_END]

