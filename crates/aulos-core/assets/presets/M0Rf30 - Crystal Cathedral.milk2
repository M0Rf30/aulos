shape_3_per_frame1=
per_frame_1=dt = min(max(time-tl,0.004),0.1); tl = time;
per_frame_2=bm = bm + (bass-bm)*(1-exp(-dt/0.8)); bd = bd + (abs(bass-bm)-bd)*(1-exp(-dt/2.5));
per_frame_3=hit = min(max(((bass-bm)/max(bd,0.1) - 0.8)/1.5, 0), 1);
per_frame_4=kick = max(kick*pow(0.86, 60*dt), hit);
per_frame_5=trig = above(kick, 0.55)*above(time, tb+0.3);
per_frame_6=tb = trig*time + (1-trig)*tb;
per_frame_7=beats = beats + trig;
per_frame_8=sb = sb*pow(0.97,60*dt) + bass_att*(1-pow(0.97,60*dt));
per_frame_9=sm = sm*pow(0.97,60*dt) + mid_att*(1-pow(0.97,60*dt));
per_frame_10=st = st*pow(0.97,60*dt) + treb_att*(1-pow(0.97,60*dt));
per_frame_11=flash = max(flash*pow(0.93,60*dt), hit*hit);
per_frame_12=rv = 0.010 + 0.006*sin(time*0.13) + 0.004*sin(time*0.31);
per_frame_13=racc = racc + (rv + 0.012*kick)*dt;
per_frame_14=zoom = 1 + (0.010 + 0.004*sb + 0.008*kick)*60*dt;
per_frame_15=rot = 0.0006*sin(time*0.21)*60*dt;
per_frame_16=q1 = kick;
per_frame_17=q2 = racc;
per_frame_18=q3 = sb;
per_frame_19=q4 = sm;
per_frame_20=q5 = st;
per_frame_21=q6 = flash;
per_frame_22=q8 = pow(0.965, 60*dt);
per_frame_23=q7 = beats;
per_frame_24=monitor = kick;
warp_1=`#define NSEG 8.0
warp_2=`#define HH 2.0
warp_3=`#define KK 5.093
warp_4=`#define ZROW 4.0
warp_5=`float2 rot2(float2 p, float a)
warp_6=`{
warp_7=`  float c = cos(a); float s = sin(a);
warp_8=`  return float2(c*p.x - s*p.y, s*p.x + c*p.y);
warp_9=`}
warp_10=`float2 hc(float cx, float cy)
warp_11=`{
warp_12=`  return float2((cx + cy*13.0 + 0.5)/256.0, (cy*7.0 + cx*3.0 + 0.5)/256.0);
warp_13=`}
warp_14=`float3 jewel(float k)
warp_15=`{
warp_16=`  float m = k - 5.0*floor(k/5.0);
warp_17=`  float3 c = float3(0.80, 0.02, 0.07);
warp_18=`  c = lerp(c, float3(1.00, 0.50, 0.03), step(0.5, m));
warp_19=`  c = lerp(c, float3(0.01, 0.62, 0.22), step(1.5, m));
warp_20=`  c = lerp(c, float3(0.03, 0.17, 0.95), step(2.5, m));
warp_21=`  c = lerp(c, float3(0.42, 0.06, 0.74), step(3.5, m));
warp_22=`  return c;
warp_23=`}
warp_24=`float2 cellp(float2 ip, float i, float j, float tt, out float4 rn, out float2 id)
warp_25=`{
warp_26=`  float cx = ip.x + i;
warp_27=`  float cy = ip.y + j;
warp_28=`  float cm = cx - 2.0*HH*floor(cx/(2.0*HH));
warp_29=`  float mir = step(HH, cm);
warp_30=`  float cxp = lerp(cm, 2.0*HH - 1.0 - cm, mir);
warp_31=`  rn = tex2Dlod(sampler_pw_noise_lq, float4(hc(cxp, cy), 0, 0));
warp_32=`  float2 o = 0.5 + 0.36*sin(tt*(0.25 + 0.5*rn.b) + 6.2831853*rn.rg);
warp_33=`  o.x = lerp(o.x, 1.0 - o.x, mir);
warp_34=`  id = float2(cxp, cy);
warp_35=`  return float2(i, j) + o;
warp_36=`}
warp_37=`float4 vor(float2 x, float tt, out float2 d1, out float edge)
warp_38=`{
warp_39=`  float2 ip = floor(x);
warp_40=`  float2 fp = x - ip;
warp_41=`  float f1 = 9.0;
warp_42=`  float2 bid = float2(0,0);
warp_43=`  float2 bd = float2(0,0);
warp_44=`  float4 rn; float2 id;
warp_45=`  for (int j = -1; j <= 1; j++)
warp_46=`  {
warp_47=`    for (int i = -1; i <= 1; i++)
warp_48=`    {
warp_49=`      float2 rr = cellp(ip, i, j, tt, rn, id) - fp;
warp_50=`      float d = dot(rr, rr);
warp_51=`      if (d < f1) { f1 = d; bd = rr; bid = id; }
warp_52=`    }
warp_53=`  }
warp_54=`  float e = 9.0;
warp_55=`  for (int j2 = -1; j2 <= 1; j2++)
warp_56=`  {
warp_57=`    for (int i2 = -1; i2 <= 1; i2++)
warp_58=`    {
warp_59=`      float2 rr = cellp(ip, i2, j2, tt, rn, id) - fp;
warp_60=`      float2 dd = rr - bd;
warp_61=`      float dl = dot(dd, dd);
warp_62=`      if (dl > 0.00001) { e = min(e, dot(0.5*(bd + rr), dd)/sqrt(dl)); }
warp_63=`    }
warp_64=`  }
warp_65=`  d1 = bd;
warp_66=`  edge = e;
warp_67=`  return float4(sqrt(f1), 0.0, bid.x, bid.y);
warp_68=`}
warp_69=`float4 rose(float2 p)
warp_70=`{
warp_71=`  float r = max(length(p), 0.07);
warp_72=`  float a = atan2(p.y, p.x);
warp_73=`  float f = abs(frac(a*(NSEG/6.2831853) + 0.5) - 0.5)*2.0;
warp_74=`  float u = log(r)*KK + 0.25*sin(time*0.11);
warp_75=`  float2 x = float2(f*HH, u);
warp_76=`  float2 d1; float e;
warp_77=`  float4 v = vor(x, time, d1, e);
warp_78=`  float4 rn = tex2Dlod(sampler_pw_noise_lq, float4(hc(v.z, v.w), 0, 0));
warp_79=`  float zone = floor((v.w + 200.0)/ZROW);
warp_80=`  float hh = zone*2.0 + rn.r*2.99 + time*0.03;
warp_81=`  float k = floor(hh);
warp_82=`  float3 col = lerp(jewel(k), jewel(k + 1.0), smoothstep(0.8, 1.0, hh - k));
warp_83=`  float pulse = saturate(sqrt(get_fft(0.015 + 0.42*rn.g))*1.5);
warp_84=`  float core = 1.0 - smoothstep(0.0, 0.7, v.x);
warp_85=`  float n = tex2D(sampler_noise_hq, x*0.37 + rn.rg*5.0).x;
warp_86=`  float sc = KK/r;
warp_87=`  float wl = 0.0055*sc;
warp_88=`  float pe = sc/texsize.y;
warp_89=`  float n2 = tex2D(sampler_noise_hq, x*1.9 + rn.ba*3.0).y;
warp_90=`  float sh = (0.22 + 1.15*core*core)*(0.7 + 0.6*n)*(0.88 + 0.24*n2);
warp_91=`  sh *= 0.5 + 0.5*smoothstep(0.0, wl*5.0, e);
warp_92=`  float sun = 0.68 + 0.9*pow(0.5 + 0.5*cos(a - time*0.31 + 1.5*sin(time*0.07)), 3.0);
warp_93=`  float back = sun*0.95 + 1.0*q1 + 0.6*q6;
warp_94=`  float3 glass = col*sh*(back + 1.3*pulse);
warp_95=`  float2 L = float2(cos(time*0.25), sin(time*0.25));
warp_96=`  float gl = exp(-pow((dot(d1, L) + 0.18)*7.0, 2.0))*smoothstep(0.6, 0.2, v.x);
warp_97=`  glass += float3(1.0, 0.95, 0.85)*gl*0.22*(0.5 + pulse + q1);
warp_98=`  float zr = abs(frac(u/ZROW + 0.5) - 0.5)*ZROW;
warp_99=`  float lead1 = 1.0 - smoothstep(wl - pe, wl + pe, e);
warp_100=`  float lead2 = 1.0 - smoothstep(wl*1.8 - pe, wl*1.8 + pe, zr);
warp_101=`  float lead = max(lead1, lead2);
warp_102=`  float2 nd = -d1/max(length(d1), 0.001);
warp_103=`  float hl = pow(saturate(dot(nd, L)), 3.0);
warp_104=`  float band = smoothstep(0.0, wl*0.5, e)*(1.0 - smoothstep(wl*0.5, wl, e));
warp_105=`  float zb = smoothstep(0.0, wl*0.8, zr)*(1.0 - smoothstep(wl*0.8, wl*1.8, zr));
warp_106=`  float3 lc = float3(0.025, 0.02, 0.03) + hl*band*float3(0.9, 0.72, 0.45)*0.9;
warp_107=`  lc += zb*float3(0.9, 0.68, 0.32)*(0.18 + 0.3*hl);
warp_108=`  return float4(lerp(glass, lc, lead), lead);
warp_109=`}
warp_110=`shader_body
warp_111=`{
warp_112=`  float ar = texsize.x*texsize.w;
warp_113=`  float2 p = (uv_orig - 0.5)*float2(ar, 1.0);
warp_114=`  float4 g = rose(rot2(p, q2));
warp_115=`  float L = dot(g.rgb, float3(0.3, 0.59, 0.11));
warp_116=`  float3 em = g.rgb*smoothstep(0.35, 1.2, L)*(1.0 - g.a);
warp_117=`  float3 prev = tex2D(sampler_main, uv).rgb;
warp_118=`  float3 bl = GetBlur1(uv);
warp_119=`  prev = lerp(prev, bl, 0.3);
warp_120=`  ret = prev*q8 + em*(1.0 - q8)*(1.2 + 1.5*q1);
warp_121=`  ret = max(ret - 0.002, 0.0);
warp_122=`}
