shape_3_per_frame1=
per_frame_1=dt = min(max(time-tl,0.004),0.1); tl = time;
per_frame_2=bm = bm + (bass-bm)*(1-exp(-dt/0.8)); bd = bd + (abs(bass-bm)-bd)*(1-exp(-dt/2.5));
per_frame_3=hit = min(max(((bass-bm)/max(bd,0.1) - 0.8)/1.5, 0), 1);
per_frame_4=kick = max(kick*pow(0.86, 60*dt), hit);
per_frame_5=trig = above(kick, 0.55)*above(time, tb+0.3);
per_frame_6=tb = trig*time + (1-trig)*tb;
per_frame_7=beats = beats + trig;
per_frame_8=sb = sb*pow(0.97,60*dt) + bass_att*(1-pow(0.97,60*dt));
per_frame_9=sm = sm*pow(0.97,60*dt) + mid_att*(1-pow(0.97,60*dt));
per_frame_10=st = st*pow(0.97,60*dt) + treb_att*(1-pow(0.97,60*dt));
per_frame_11=flash = max(flash*pow(0.92,60*dt), hit*hit);
per_frame_12=rv = 0.012 + 0.008*sin(time*0.09) + 0.004*sin(time*0.27);
per_frame_13=racc = racc + (rv + 0.006*kick)*dt;
per_frame_14=zoom = 1 + (0.0025 + 0.0020*sb + 0.003*kick)*60*dt;
per_frame_15=rot = 0.0008*sin(time*0.17)*60*dt;
per_frame_16=q1 = kick;
per_frame_17=q2 = racc;
per_frame_18=q3 = sb;
per_frame_19=q4 = sm;
per_frame_20=q5 = st;
per_frame_21=q6 = flash;
per_frame_22=q7 = beats;
per_frame_23=q8 = pow(0.93, 60*dt);
per_frame_24=monitor = kick;
warp_1=`#define HX 0.8660254
warp_2=`float2 rot2(float2 p, float a)
warp_3=`{
warp_4=`  float c = cos(a); float s = sin(a);
warp_5=`  return float2(c*p.x - s*p.y, s*p.x + c*p.y);
warp_6=`}
warp_7=`float2 camx(float2 p, float sc)
warp_8=`{
warp_9=`  float zm = 1.0 + 0.14*sin(time*0.045) + 0.05*sin(time*0.11);
warp_10=`  float2 cam = float2(time*0.014, time*0.009) + 0.05*float2(sin(time*0.13), cos(time*0.11));
warp_11=`  return rot2(p, q2)*sc/zm + cam;
warp_12=`}
warp_13=`float2 hcell(float2 ip, float i, float j, float tt, float jit, out float4 rn)
warp_14=`{
warp_15=`  float cx = ip.x + i;
warp_16=`  float cy = ip.y + j;
warp_17=`  rn = tex2Dlod(sampler_pw_noise_lq, float4((cx + cy*17.0 + 0.5)/256.0, (cy*5.0 + cx*11.0 + 0.5)/256.0, 0, 0));
warp_18=`  float odd = cy - 2.0*floor(cy*0.5);
warp_19=`  float2 o = 0.5 + jit*sin(tt*(0.2 + 0.4*rn.b) + 6.2831853*rn.rg);
warp_20=`  return float2(i + 0.5*odd + o.x, (j + o.y)*HX);
warp_21=`}
warp_22=`float4 hexv(float2 x, float tt, float jit, out float2 d1, out float4 brn)
warp_23=`{
warp_24=`  float yg = x.y/HX;
warp_25=`  float2 ip = floor(float2(x.x, yg));
warp_26=`  float2 fp = float2(x.x - ip.x, (yg - ip.y)*HX);
warp_27=`  float f1 = 9.0; float f2 = 9.0;
warp_28=`  float2 bd = float2(0, 0);
warp_29=`  float2 bid = float2(0, 0);
warp_30=`  float4 rn; float4 bn = float4(0, 0, 0, 0);
warp_31=`  for (int j = -1; j <= 1; j++)
warp_32=`  {
warp_33=`    for (int i = -1; i <= 1; i++)
warp_34=`    {
warp_35=`      float2 rr = hcell(ip, i, j, tt, jit, rn) - fp;
warp_36=`      float d = length(rr);
warp_37=`      if (d < f1) { f2 = f1; f1 = d; bd = rr; bn = rn; bid = ip + float2(i, j); }
warp_38=`      else if (d < f2) { f2 = d; }
warp_39=`    }
warp_40=`  }
warp_41=`  d1 = bd; brn = bn;
warp_42=`  return float4(f1, f2, bid.x, bid.y);
warp_43=`}
warp_44=`float hexedge(float2 x, float tt, float jit, float2 bd)
warp_45=`{
warp_46=`  float yg = x.y/HX;
warp_47=`  float2 ip = floor(float2(x.x, yg));
warp_48=`  float2 fp = float2(x.x - ip.x, (yg - ip.y)*HX);
warp_49=`  float e = 9.0;
warp_50=`  float4 rn;
warp_51=`  for (int j = -1; j <= 1; j++)
warp_52=`  {
warp_53=`    for (int i = -1; i <= 1; i++)
warp_54=`    {
warp_55=`      float2 rr = hcell(ip, i, j, tt, jit, rn) - fp;
warp_56=`      float2 dd = rr - bd;
warp_57=`      float dl = dot(dd, dd);
warp_58=`      if (dl > 0.00001) { e = min(e, dot(0.5*(bd + rr), dd)/sqrt(dl)); }
warp_59=`    }
warp_60=`  }
warp_61=`  return e;
warp_62=`}
warp_63=`float fog(float2 q, float t)
warp_64=`{
warp_65=`  float n1 = tex2D(sampler_noise_hq, q*0.33 + float2(t*0.010, -t*0.006)).x;
warp_66=`  float n2 = tex2D(sampler_noise_hq, q*0.85 + float2(-t*0.020, t*0.013)).y;
warp_67=`  return 0.6*n1 + 0.4*n2;
warp_68=`}
warp_69=`shader_body
warp_70=`{
warp_71=`  float ar = texsize.x*texsize.w;
warp_72=`  float2 p = (uv_orig - 0.5)*float2(ar, 1.0);
warp_73=`  float2 x = camx(p, 7.0);
warp_74=`  float2 d1; float4 rn;
warp_75=`  float4 v = hexv(x, time*0.8, 0.17, d1, rn);
warp_76=`  float2 tilt = (rn.ba - 0.5)*1.8 + d1*0.25;
warp_77=`  float2 disp = tilt*float2(1.0/ar, 1.0)*(0.0035 + 0.004*q1);
warp_78=`  float3 prev = tex2D(sampler_main, uv + disp).rgb;
warp_79=`  float3 bl = GetBlur1(uv + disp);
warp_80=`  prev = lerp(prev, bl, 0.25);
warp_81=`  float e = v.y - v.x;
warp_82=`  float web = pow(saturate(1.0 - e*4.0), 4.0);
warp_83=`  float3 n = normalize(float3(tilt, 1.0));
warp_84=`  float3 L1 = normalize(float3(cos(time*0.41)*0.8, sin(time*0.33)*0.8, 0.7));
warp_85=`  float3 L2 = normalize(float3(sin(time*0.23 + 2.0)*0.9, cos(time*0.29)*0.7, 0.8));
warp_86=`  float sp = pow(saturate(dot(n, normalize(L1 + float3(0, 0, 1)))), 70.0);
warp_87=`  sp += pow(saturate(dot(n, normalize(L2 + float3(0, 0, 1)))), 70.0);
warp_88=`  float fv = sqrt(get_fft(0.02 + 0.4*rn.g));
warp_89=`  float3 em = float3(0.30, 0.80, 1.0)*web*(0.35 + 1.4*fv) + float3(0.85, 0.95, 1.0)*sp*(1.0 + 1.6*fv + q1);
warp_90=`  ret = prev*q8 + em*(1.0 - q8)*1.0;
warp_91=`  ret = max(ret - 0.002, 0.0);
warp_92=`}
comp_1=`#define HX 0.8660254
comp_2=`float2 rot2(float2 p, float a)
comp_3=`{
comp_4=`  float c = cos(a); float s = sin(a);
comp_5=`  return float2(c*p.x - s*p.y, s*p.x + c*p.y);
comp_6=`}
comp_7=`float2 camx(float2 p, float sc)
comp_8=`{
comp_9=`  float zm = 1.0 + 0.14*sin(time*0.045) + 0.05*sin(time*0.11);
comp_10=`  float2 cam = float2(time*0.014, time*0.009) + 0.05*float2(sin(time*0.13), cos(time*0.11));
comp_11=`  return rot2(p, q2)*sc/zm + cam;
comp_12=`}
comp_13=`float2 hcell(float2 ip, float i, float j, float tt, float jit, out float4 rn)
comp_14=`{
comp_15=`  float cx = ip.x + i;
comp_16=`  float cy = ip.y + j;
comp_17=`  rn = tex2Dlod(sampler_pw_noise_lq, float4((cx + cy*17.0 + 0.5)/256.0, (cy*5.0 + cx*11.0 + 0.5)/256.0, 0, 0));
comp_18=`  float odd = cy - 2.0*floor(cy*0.5);
comp_19=`  float2 o = 0.5 + jit*sin(tt*(0.2 + 0.4*rn.b) + 6.2831853*rn.rg);
comp_20=`  return float2(i + 0.5*odd + o.x, (j + o.y)*HX);
comp_21=`}
comp_22=`float4 hexv(float2 x, float tt, float jit, out float2 d1, out float4 brn)
comp_23=`{
comp_24=`  float yg = x.y/HX;
comp_25=`  float2 ip = floor(float2(x.x, yg));
comp_26=`  float2 fp = float2(x.x - ip.x, (yg - ip.y)*HX);
comp_27=`  float f1 = 9.0; float f2 = 9.0;
comp_28=`  float2 bd = float2(0, 0);
comp_29=`  float2 bid = float2(0, 0);
comp_30=`  float4 rn; float4 bn = float4(0, 0, 0, 0);
comp_31=`  for (int j = -1; j <= 1; j++)
comp_32=`  {
comp_33=`    for (int i = -1; i <= 1; i++)
comp_34=`    {
comp_35=`      float2 rr = hcell(ip, i, j, tt, jit, rn) - fp;
comp_36=`      float d = length(rr);
comp_37=`      if (d < f1) { f2 = f1; f1 = d; bd = rr; bn = rn; bid = ip + float2(i, j); }
comp_38=`      else if (d < f2) { f2 = d; }
comp_39=`    }
comp_40=`  }
comp_41=`  d1 = bd; brn = bn;
comp_42=`  return float4(f1, f2, bid.x, bid.y);
comp_43=`}
comp_44=`float hexedge(float2 x, float tt, float jit, float2 bd)
comp_45=`{
comp_46=`  float yg = x.y/HX;
comp_47=`  float2 ip = floor(float2(x.x, yg));
comp_48=`  float2 fp = float2(x.x - ip.x, (yg - ip.y)*HX);
comp_49=`  float e = 9.0;
comp_50=`  float4 rn;
comp_51=`  for (int j = -1; j <= 1; j++)
comp_52=`  {
comp_53=`    for (int i = -1; i <= 1; i++)
comp_54=`    {
comp_55=`      float2 rr = hcell(ip, i, j, tt, jit, rn) - fp;
comp_56=`      float2 dd = rr - bd;
comp_57=`      float dl = dot(dd, dd);
comp_58=`      if (dl > 0.00001) { e = min(e, dot(0.5*(bd + rr), dd)/sqrt(dl)); }
comp_59=`    }
comp_60=`  }
comp_61=`  return e;
comp_62=`}
comp_63=`float fog(float2 q, float t)
comp_64=`{
comp_65=`  float n1 = tex2D(sampler_noise_hq, q*0.33 + float2(t*0.010, -t*0.006)).x;
comp_66=`  float n2 = tex2D(sampler_noise_hq, q*0.85 + float2(-t*0.020, t*0.013)).y;
comp_67=`  return 0.6*n1 + 0.4*n2;
comp_68=`}
comp_69=`shader_body
comp_70=`{
comp_71=`  float ar = texsize.x*texsize.w;
comp_72=`  float2 p = (uv - 0.5)*float2(ar, 1.0);
comp_73=`  float r = length(p);
comp_74=`  float2 x = camx(p, 7.0);
comp_75=`  float tt = time*0.8;
comp_76=`  float2 d1; float4 rn;
comp_77=`  float4 v = hexv(x, tt, 0.17, d1, rn);
comp_78=`  float e = hexedge(x, tt, 0.17, d1);
comp_79=`  float2 tilt = (rn.ba - 0.5)*1.8 + d1*0.25;
comp_80=`  float3 n = normalize(float3(tilt, 1.0));
comp_81=`  float2 ro = tilt*(0.07 + 0.04*q1);
comp_82=`  float2 q0 = p*0.9;
comp_83=`  float fr = fog(q0 + ro, time);
comp_84=`  float fg = fog(q0 + ro*1.18, time);
comp_85=`  float fbl = fog(q0 + ro*1.36, time);
comp_86=`  float3 bg;
comp_87=`  bg.r = 0.02 + 0.24*pow(smoothstep(0.5, 0.95, fr), 1.5);
comp_88=`  bg.g = 0.05 + 0.55*smoothstep(0.35, 0.85, fg);
comp_89=`  bg.b = 0.12 + 0.85*smoothstep(0.2, 0.75, fbl);
comp_90=`  float2 lp = q0 - float2(0.2*sin(time*0.07), -0.8);
comp_91=`  float beam = pow(0.5 + 0.5*sin(atan2(lp.x, lp.y)*11.0 + fg*4.0 + time*0.25), 5.0)*smoothstep(1.7, 0.1, length(lp));
comp_92=`  bg += float3(0.06, 0.26, 0.40)*beam*(0.8 + 0.7*q3 + 0.8*q1);
comp_93=`  float3 L1 = normalize(float3(cos(time*0.41)*0.8, sin(time*0.33)*0.8, 0.7));
comp_94=`  float3 L2 = normalize(float3(sin(time*0.23 + 2.0)*0.9, cos(time*0.29)*0.7, 0.8));
comp_95=`  float dif = saturate(dot(n, L1))*0.6 + saturate(dot(n, L2))*0.4;
comp_96=`  float viol = step(0.74, rn.r);
comp_97=`  float3 tint = lerp(float3(0.85, 1.0, 1.1), float3(0.95, 0.60, 1.35), viol);
comp_98=`  tint *= 0.75 + 0.5*rn.r;
comp_99=`  float frost = tex2D(sampler_noise_hq, x*2.3 + rn.rg*7.0).x;
comp_100=`  float3 col = bg*tint*(0.28 + 1.15*dif)*(0.78 + 0.45*frost);
comp_101=`  float sp = pow(saturate(dot(n, normalize(L1 + float3(0, 0, 1)))), 140.0);
comp_102=`  sp += pow(saturate(dot(n, normalize(L2 + float3(0, 0, 1)))), 140.0);
comp_103=`  float pf = sqrt(get_fft(0.02 + 0.4*rn.g));
comp_104=`  col += float3(0.55, 0.88, 1.0)*sp*(0.8 + 1.4*pf + q1);
comp_105=`  float rim = smoothstep(0.05, 0.4, length(tilt));
comp_106=`  col += lerp(float3(0.10, 0.45, 0.65), float3(0.35, 0.25, 0.80), viol)*rim*0.6;
comp_107=`  float eb = exp(-e*20.0);
comp_108=`  col += float3(0.45, 0.90, 1.0)*eb*(0.45 + 0.7*q1 + 0.6*pf);
comp_109=`  float2 x2 = rot2(x, 0.7)*2.3 + 0.12*sin(x.yx*3.0 + time*0.9) + ro*2.0;
comp_110=`  float2 d2; float4 rn2;
comp_111=`  float4 v2 = hexv(x2, time*1.6, 0.42, d2, rn2);
comp_112=`  float pf2 = sqrt(get_fft(0.02 + 0.4*rn2.g));
comp_113=`  float web = pow(saturate(1.0 - (v2.y - v2.x)*3.0), 5.0);
comp_114=`  col += float3(0.45, 0.95, 1.0)*web*(0.35 + 1.4*pf2 + 0.8*q1)*(0.4 + 0.6*smoothstep(0.3, 0.8, fg));
comp_115=`  float2 ca = p/max(r, 0.001)*0.004*r;
comp_116=`  float2 uo = ro/float2(ar, 1.0)*0.5;
comp_117=`  float3 fb;
comp_118=`  fb.r = tex2D(sampler_main, uv + uo + ca).r;
comp_119=`  fb.g = tex2D(sampler_main, uv + uo*1.1).g;
comp_120=`  fb.b = tex2D(sampler_main, uv + uo*1.2 - ca).b;
comp_121=`  float3 b2 = GetBlur2(uv);
comp_122=`  float3 b3 = GetBlur3(uv);
comp_123=`  col += fb*0.55 + b2*0.18 + b3*(0.22 + 0.5*q6);
comp_124=`  float cav = tex2D(sampler_noise_hq, p*0.22 + float2(0.3, time*0.004)).z;
comp_125=`  col *= lerp(0.45, 1.3, smoothstep(0.30, 0.72, cav));
comp_126=`  col += float3(0.06, 0.24, 0.36)*beam*(0.6 + 0.8*q3 + 0.8*q1);
comp_127=`  float3 dust = float3(0, 0, 0);
comp_128=`  for (int i = 0; i < 2; i++)
comp_129=`  {
comp_130=`    float fi = float(i);
comp_131=`    float2 gp = p*(10.0 + 8.0*fi) + float2(fi*5.3, time*(0.30 + 0.2*fi));
comp_132=`    float2 gid = floor(gp);
comp_133=`    float4 dn = tex2Dlod(sampler_pw_noise_lq, float4((gid + 0.5)/256.0, 0, 0));
comp_134=`    float2 dpos = frac(gp) - 0.5 - (dn.rg - 0.5)*0.5;
comp_135=`    float tw = 0.5 + 0.5*sin(time*(1.5 + 3.0*dn.b) + dn.a*40.0);
comp_136=`    float big = step(0.93, dn.b);
comp_137=`    float spike = exp(-abs(dpos.x)*30.0)*exp(-abs(dpos.y)*4.0) + exp(-abs(dpos.y)*30.0)*exp(-abs(dpos.x)*4.0);
comp_138=`    float dr = length(dpos);
comp_139=`    dust += float3(0.75, 0.95, 1.0)*step(0.74, dn.a)*(exp(-dr*dr*(240.0 + 300.0*dn.b)) + big*0.5*spike)*tw*(0.6 + 0.7*q1);
comp_140=`  }
comp_141=`  col += dust*0.8;
comp_142=`  col *= 1.0 + 0.6*q1 + 0.25*q6;
comp_143=`  col = 1.0 - exp(-col*1.2);
comp_144=`  float l = dot(col, float3(0.3, 0.59, 0.11));
comp_145=`  col = lerp(float3(l, l, l), col, 1.25);
comp_146=`  col = saturate(col);
comp_147=`  col = lerp(col, col*col*(3.0 - 2.0*col), 0.55);
comp_148=`  float vg = smoothstep(1.2, 0.3, r);
comp_149=`  col *= lerp(0.40, 1.0, vg);
comp_150=`  col += float3(0.03, 0.01, 0.09)*(1.0 - vg);
comp_151=`  ret = col;
comp_152=`}
[PRESET2_END]
