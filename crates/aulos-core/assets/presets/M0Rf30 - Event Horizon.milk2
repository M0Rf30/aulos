shape_3_per_frame1=
per_frame_1=dt = min(max(time-tl,0.004),0.1); tl = time; bm = bm + (bass-bm)*(1-exp(-dt/0.8)); bd = bd + (abs(bass-bm)-bd)*(1-exp(-dt/2.5));
per_frame_2=hit = min(max(((bass-bm)/max(bd,0.1) - 0.8)/1.5, 0), 1);
per_frame_3=kick = max(kick*pow(0.87, 60*dt), hit);
per_frame_4=trig = above(kick, 0.55)*above(time, tb+0.35);
per_frame_5=tb = trig*time + (1-trig)*tb;
per_frame_6=init = below(frame, 1);
per_frame_7=a3 = trig*a2 + (1-trig)*(a3+dt) + 9*init;
per_frame_8=a2 = trig*a1 + (1-trig)*(a2+dt) + 9*init;
per_frame_9=a1 = trig*0 + (1-trig)*(a1+dt);
per_frame_10=sb = sb*pow(0.97,60*dt) + bass_att*(1-pow(0.97,60*dt));
per_frame_11=sm = sm*pow(0.97,60*dt) + mid_att*(1-pow(0.97,60*dt));
per_frame_12=st = st*pow(0.97,60*dt) + treb_att*(1-pow(0.97,60*dt));
per_frame_13=sbn = min(max(sb-1,-0.5),1.0);
per_frame_14=spin = spin + dt*(0.05 + 0.04*sm);
per_frame_15=zoom = 1; rot = 0;
per_frame_16=q1 = kick;
per_frame_17=q2 = dt;
per_frame_18=q3 = sb;
per_frame_19=q4 = sm;
per_frame_20=q5 = st;
per_frame_21=q6 = a1;
per_frame_22=q7 = a2;
per_frame_23=q8 = a3;
per_frame_24=q9 = time*0.5 + sm*0.3;
per_frame_25=q10 = spin;
per_frame_26=q11 = 0.03 + 0.7*(1 - exp(-a1*1.5));
per_frame_27=q12 = exp(-a1*1.1);
per_frame_28=monitor = kick;
per_frame_29=q13 = 0.5 + 0.06*sin(time*0.13) + 0.025*sin(time*0.31+1);
per_frame_30=q14 = 0.5 + 0.045*cos(time*0.11) + 0.02*sin(time*0.27);
per_frame_31=q15 = 0.6 + 0.5*sin(time*0.07) + spin*0.3;
warp_1=`float fil(float2 p, float tt)
warp_2=`{
warp_3=`  float n = 0.0;
warp_4=`  float it = 1.0;
warp_5=`  float w = 1.0;
warp_6=`  for (int i = 0; i < 5; i++)
warp_7=`  {
warp_8=`    float v = 1.0 - 0.5*abs(sin(p.y*it + tt*(0.3 + 0.2*float(i))) + cos(p.x*it - tt*0.2));
warp_9=`    n += w*v*v;
warp_10=`    p = float2(p.x*0.6 - p.y*0.8, p.x*0.8 + p.y*0.6) + 0.37;
warp_11=`    it *= 1.75;
warp_12=`    w *= 0.5;
warp_13=`  }
warp_14=`  return n*0.52;
warp_15=`}
warp_16=`float front(float r, float R, float2 p, float amp)
warp_17=`{
warp_18=`  float nj = tex2D(sampler_noise_hq, p*0.9 + R*1.3).x - 0.5;
warp_19=`  float d = r - R*(1.0 + 0.55*nj);
warp_20=`  return smoothstep(-0.26, 0.0, d)*(1.0 - smoothstep(0.0, 0.05, d))*amp;
warp_21=`}
warp_22=`shader_body
warp_23=`{
warp_24=`  float ar = texsize.x*texsize.w;
warp_25=`  float2 c0 = float2(q13, q14);
warp_26=`  float2 p = (uv_orig - c0)*float2(ar, 1.0);
warp_27=`  float t = time;
warp_28=`  float r = length(p);
warp_29=`  float dtf = q2*60.0;
warp_30=`  float ex = 1.0 + (0.008 + 0.012*q1 + 0.004*q3)*dtf*(1.0 + 0.5/(1.0 + r*6.0));
warp_31=`  float da = q2*0.25/(r + 0.25);
warp_32=`  float cs = cos(da);
warp_33=`  float sn = sin(da);
warp_34=`  float2 pn = p*0.9 + float2(t*0.02, -t*0.015);
warp_35=`  float n0 = tex2D(sampler_noise_hq, pn).x;
warp_36=`  float nx = tex2D(sampler_noise_hq, pn + float2(0.02, 0.0)).x;
warp_37=`  float ny = tex2D(sampler_noise_hq, pn + float2(0.0, 0.02)).x;
warp_38=`  float2 curl = float2(ny - n0, n0 - nx)*50.0;
warp_39=`  float2 ps = float2(cs*p.x + sn*p.y, -sn*p.x + cs*p.y)/ex;
warp_40=`  ps += curl*0.0006*dtf*(0.6 + 0.8*q4);
warp_41=`  float2 suv = ps/float2(ar, 1.0) + c0;
warp_42=`  float3 prev = tex2D(sampler_main, suv).rgb;
warp_43=`  prev = lerp(prev, GetBlur1(suv), 0.13);
warp_44=`  float ca = cos(q15);
warp_45=`  float sa = sin(q15);
warp_46=`  float2 pq = float2(ca*p.x + sa*p.y, -sa*p.x + ca*p.y);
warp_47=`  float2 pe = p/(r + 0.12)*2.2 + p*0.5;
warp_48=`  float2 w1 = float2(fil(pe*0.9 + 1.7, q9*0.6), fil(pe*0.9 - 2.3, q9*0.5 + 4.0)) - 0.5;
warp_49=`  float fn = fil(pe*1.5 + w1*2.4 + float2(q9*0.05, 0.0), q9);
warp_50=`  float f = smoothstep(0.38, 0.85, fn);
warp_51=`  f = f*f;
warp_52=`  float R1 = q11;
warp_53=`  float R2 = 0.03 + 0.7*(1.0 - exp(-q7*1.5));
warp_54=`  float R3 = 0.03 + 0.7*(1.0 - exp(-q8*1.5));
warp_55=`  float m = front(r, R1, p, q12) + front(r, R2, p, exp(-q7*1.1)) + front(r, R3, p, exp(-q8*1.1));
warp_56=`  float jet = exp(-pq.x*pq.x/(0.004 + 0.035*r))*smoothstep(0.05, 0.3, r)*smoothstep(1.0, 0.35, r);
warp_57=`  float mask = m*2.4 + jet*(0.5 + 0.9*q4 + 0.7*q1) + 0.06*exp(-r*4.5);
warp_58=`  float3 cold = lerp(float3(0.04, 0.20, 1.0), float3(0.10, 0.80, 1.0), smoothstep(0.1, 0.7, f));
warp_59=`  float3 col = lerp(cold, float3(0.58, 0.18, 1.0), saturate(r*1.3 + 0.6*w1.x));
warp_60=`  col = lerp(col, float3(0.95, 0.25, 0.80), saturate((r - 0.35)*1.6)*f*0.5);
warp_61=`  col = lerp(col, float3(0.85, 0.93, 1.0), f*f*0.6*exp(-r*3.0));
warp_62=`  float3 inj = col*f*mask;
warp_63=`  float an = atan2(p.y, p.x);
warp_64=`  float sp = get_fft(abs(an)*0.318*0.5);
warp_65=`  float sring = exp(-pow((r - 0.07)/0.02, 2.0))*sp*3.0;
warp_66=`  inj += lerp(float3(0.2, 0.6, 1.0), float3(0.9, 0.5, 1.0), abs(an)*0.318)*sring;
warp_67=`  ret = prev*0.945 + inj*0.034*(1.0 + 1.6*q1)*(1.0 + 2.0*exp(-t*1.5));
warp_68=`  ret *= smoothstep(1.25, 0.85, r)*0.5 + 0.5;
warp_69=`  ret = max(ret - 0.004, 0.0);
warp_70=`}
comp_1=`float shock(float r, float R, float amp, float2 p)
comp_2=`{
comp_3=`  float nj = tex2Dlod(sampler_noise_hq, float4(p*0.9 + R*1.3, 0.0, 1.0)).x - 0.5;
comp_4=`  float d = r - R*(1.0 + 0.55*nj);
comp_5=`  float fr = exp(-d*d/(0.00012 + 0.0007*R*R));
comp_6=`  float wake = exp(-max(-d, 0.0)*6.0)*step(d, 0.0)*0.07;
comp_7=`  return (fr + wake)*amp;
comp_8=`}
comp_9=`shader_body
comp_10=`{
comp_11=`  float ar = texsize.x*texsize.w;
comp_12=`  float2 c0 = float2(q13, q14);
comp_13=`  float2 p = (uv - c0)*float2(ar, 1.0);
comp_14=`  float r = length(p);
comp_15=`  float t = time;
comp_16=`  float2 ca = p/max(r, 0.001)*0.004*(0.3 + r);
comp_17=`  float3 c;
comp_18=`  c.r = tex2D(sampler_main, saturate(uv + ca/float2(ar, 1.0))).r;
comp_19=`  c.g = tex2D(sampler_main, uv).g;
comp_20=`  c.b = tex2D(sampler_main, saturate(uv - ca/float2(ar, 1.0))).b;
comp_21=`  float3 b1 = GetBlur1(uv);
comp_22=`  float3 b2 = GetBlur2(uv);
comp_23=`  float3 b3 = GetBlur3(uv);
comp_24=`  float3 gas = (c + (c - b1)*0.5)*1.3;
comp_25=`  gas = max(gas, 0.0);
comp_26=`  float3 glow = b1*0.12 + b2*0.2 + b3*0.3;
comp_27=`  float3 back = float3(0.012, 0.02, 0.085)*smoothstep(1.3, 0.0, r) + float3(0.0, 0.0, 0.012);
comp_28=`  float3 col = gas + glow + back;
comp_29=`  float R1 = q11;
comp_30=`  float R2 = 0.03 + 0.7*(1.0 - exp(-q7*1.5));
comp_31=`  float R3 = 0.03 + 0.7*(1.0 - exp(-q8*1.5));
comp_32=`  float A2 = exp(-q7*1.1);
comp_33=`  float A3 = exp(-q8*1.1);
comp_34=`  float3 sw = float3(shock(r*0.99, R1, q12, p), shock(r, R1, q12, p), shock(r*1.01, R1, q12, p));
comp_35=`  sw += float3(shock(r*0.99, R2, A2, p), shock(r, R2, A2, p), shock(r*1.01, R2, A2, p));
comp_36=`  sw += float3(shock(r*0.99, R3, A3, p), shock(r, R3, A3, p), shock(r*1.01, R3, A3, p));
comp_37=`  col += sw*float3(0.55, 0.85, 1.25)*1.2;
comp_38=`  float an = atan2(p.y, p.x) + 2.4*r + 0.35*sin(r*9.0 - t*1.3);
comp_39=`  float cell = (an*0.159155 + 0.5)*30.0;
comp_40=`  float cid = floor(cell);
comp_41=`  float cf = frac(cell) - 0.5;
comp_42=`  float4 rn = tex2Dlod(sampler_pw_noise_lq, float4((cid + 0.5)/256.0, 0.5, 0.0, 0.0));
comp_43=`  float fz = get_fft(frac(cid*0.0333 + 0.5)*0.5);
comp_44=`  float ln = 0.06 + 0.7*sqrt(fz)*(0.5 + rn.a) + 0.4*q1*rn.g;
comp_45=`  float ray = exp(-cf*cf*45.0)*exp(-r/ln)*(0.4 + rn.r)/(1.0 + r*7.0);
comp_46=`  float an2 = an*0.5 + q10;
comp_47=`  float cf2 = frac((an2*0.159155 + 0.5)*7.0) - 0.5;
comp_48=`  float ray2 = exp(-cf2*cf2*200.0)*exp(-r*2.4)*(0.25 + 0.7*q1)/(1.0 + r*5.0);
comp_49=`  float cg = exp(-r*10.0)*0.5*(0.6 + q1) + exp(-r*34.0)*1.0*(0.7 + 0.6*q1) + exp(-r*110.0)*1.6*(0.6 + q1);
comp_50=`  float3 hot = lerp(float3(0.25, 0.55, 1.0), float3(0.92, 0.96, 1.0), saturate(exp(-r*26.0)*(0.7 + q1)));
comp_51=`  col += hot*cg*1.1 + float3(0.35, 0.55, 1.0)*(ray*1.0 + ray2*1.4)*(0.5 + 0.8*q1);
comp_52=`  col += float3(0.5, 0.25, 1.0)*exp(-r*5.0)*(0.2 + 0.4*q1);
comp_53=`  float3 st = float3(0.0, 0.0, 0.0);
comp_54=`  for (int j = 0; j < 3; j++)
comp_55=`  {
comp_56=`    float fj = float(j);
comp_57=`    float ph = frac(t*0.05 + fj/3.0);
comp_58=`    float s = lerp(1.0, 2.4, ph);
comp_59=`    float fade = sin(3.14159*ph);
comp_60=`    float2 sp = p/s;
comp_61=`    float N = 30.0 + 22.0*fj;
comp_62=`    float2 gp = sp*N + fj*17.3;
comp_63=`    float2 id = floor(gp);
comp_64=`    float2 fr = frac(gp) - 0.5;
comp_65=`    float4 rd = tex2Dlod(sampler_pw_noise_lq, float4((id + 0.5)/256.0, 0.0, 0.0));
comp_66=`    float on = step(0.972, rd.r);
comp_67=`    float2 o = (rd.gb - 0.5)*0.5;
comp_68=`    float2 dd = fr - o;
comp_69=`    float core = exp(-dot(dd, dd)*lerp(260.0, 100.0, rd.a));
comp_70=`    float inten = (0.5 + 0.9*rd.a)*(1.0 + 0.4*sin(t*3.0 + rd.b*40.0)*q5);
comp_71=`    float3 sc = lerp(float3(0.6, 0.9, 1.0), float3(0.95, 0.85, 1.0), rd.b);
comp_72=`    st += on*fade*sc*inten*core;
comp_73=`  }
comp_74=`  col += st*1.3;
comp_75=`  col *= 1.0 + 0.15*q1;
comp_76=`  col = 1.0 - exp(-col*1.15);
comp_77=`  float lw = dot(col, float3(0.3, 0.59, 0.11));
comp_78=`  col += max(lw - 0.6, 0.0)*float3(0.1, 0.25, 0.5);
comp_79=`  col = lerp(float3(lw, lw, lw), col, 1.3);
comp_80=`  col = pow(saturate(col), float3(1.2, 1.15, 1.05));
comp_81=`  col *= lerp(0.55, 1.0, smoothstep(1.1, 0.2, r));
comp_82=`  ret = saturate(col);
comp_83=`}
[PRESET2_END]
