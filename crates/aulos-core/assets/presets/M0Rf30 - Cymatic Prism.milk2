comp_32=`  float bm1 = exp(-d1*d1/(w1*w1)) + 0.25*exp(-d1*d1/(w1*w1*30.0));
comp_33=`  bm1 *= smoothstep(-1.3, -0.1, along)*(0.5 + 0.9*fogn);
