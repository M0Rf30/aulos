comp_63=`}
comp_64=`shader_body
comp_65=`{
comp_66=`  float ar = texsize.x*texsize.w;
comp_67=`  float2 p = float2((uv.x - 0.5)*ar, 0.5 - uv.y);
comp_68=`  float fl = 1.0 - smoothstep(-0.012, 0.0, p.y - yf);
comp_69=`  float depth = saturate((yf - p.y)*2.2);
comp_70=`  float2 q = float2(p.x, yf + abs(p.y - yf));
comp_71=`  float2 rp = tex2D(sampler_noise_lq, p*float2(3.0, 14.0) + float2(0.0, q18*0.03)).xy - 0.5;
comp_72=`  q += rp*float2(0.010, 0.004)*fl*(0.3 + depth);
comp_73=`  float2 uvq = float2(q.x/ar + 0.5, 0.5 - q.y);
comp_74=`  float n1 = tex2D(sampler_noise_mq, q*0.8 + float2(q18*0.010, -q18*0.017)).x;
comp_75=`  float n2 = tex2D(sampler_noise_lq, q*2.1 + float2(-q18*0.020, q18*0.015)).x;
comp_76=`  float fg = 0.55*n1 + 0.45*n2;
comp_77=`  float3 L = light(q, fg);
comp_78=`  float3 hz = tex2D(sampler_fc_main, uvq).xyz;
comp_79=`  float3 b2 = GetBlur2(uvq);
comp_80=`  float3 b3 = GetBlur3(uvq);
comp_81=`  float pd = prism(q);
comp_82=`  float2 cq = q - PC;
comp_83=`  float ins = 1.0 - smoothstep(-0.003, 0.003, pd);
comp_84=`  float3 gl = float3(0.018, 0.028, 0.040) + float3(0.04, 0.06, 0.09)*saturate(0.5 - cq.y*3.0);
comp_85=`  gl += float3(0.05, 0.07, 0.10)*pow(saturate(0.5 + 0.5*sin(cq.x*40.0 - cq.y*25.0 + q18*0.4)), 6.0)*0.4;
comp_86=`  float rim = exp(-pow(pd/0.0035, 2.0));
comp_87=`  float3 rc = spec(frac(atan2(cq.y, cq.x)*0.159 + 0.5 + q18*0.05));
comp_88=`  float bev = exp(-pow((pd + 0.016)/0.0022, 2.0))*(1.0 - smoothstep(-0.003, 0.003, pd));
comp_89=`  gl += spec(frac(cq.x*2.5 + cq.y*1.5 + q18*0.08))*0.035;
comp_90=`  float3 glass = gl*ins + rim*(0.30*rc + 0.20) + bev*(0.10*rc + 0.06) + exp(-max(pd, 0.0)*55.0)*0.02*rc;
comp_91=`  float3 sc = L*1.0 + hz*0.75 + b2*0.5 + b3*0.45 + glass;
comp_92=`  float2 g = q*float2(70.0, 70.0) + float2(q18*0.35, q18*0.22);
comp_93=`  float2 gi = floor(g);
comp_94=`  float4 hh = tex2D(sampler_pw_noise_lq, (gi + 0.5)/256.0);
comp_95=`  float2 gf = frac(g) - (0.2 + 0.6*hh.yz);
comp_96=`  float tw = 0.5 + 0.5*sin(time*(2.0 + hh.w*5.0) + hh.z*40.0);
comp_97=`  float lit = saturate(dot(L + hz*0.8, float3(0.4, 0.4, 0.4)) - 0.02);
comp_98=`  float dust = step(0.55, hh.x)*exp(-dot(gf, gf)*60.0)*tw;
comp_99=`  sc += dust*lit*float3(1.0, 0.95, 0.85)*3.0;
comp_100=`  float2 g2 = q*float2(37.0, 37.0) + float2(-q18*0.21, q18*0.17) + 11.3;
comp_101=`  float2 gi2 = floor(g2);
comp_102=`  float4 h2 = tex2D(sampler_pw_noise_lq, (gi2 + 0.5)/256.0 + 0.31);
comp_103=`  float2 gf2 = frac(g2) - (0.2 + 0.6*h2.yz);
comp_104=`  float tw2 = 0.5 + 0.5*sin(time*(1.0 + h2.w*3.0) + h2.z*30.0);
comp_105=`  sc += step(0.8, h2.x)*exp(-dot(gf2, gf2)*30.0)*tw2*lit*float3(1.0, 0.9, 0.75)*5.0;
comp_106=`  float2 EP = float2(q9, q10);
comp_107=`  float2 XP = float2(q11, q12);
comp_108=`  sc += float3(1.0, 0.95, 0.9)*exp(-abs(q.y - EP.y)/0.003)*exp(-abs(q.x - EP.x)*2.2)*(0.05 + 0.7*q16);
comp_109=`  sc += spec(0.5)*exp(-abs(q.y - XP.y)/0.003)*exp(-abs(q.x - XP.x)*2.5)*(0.04 + 0.4*q16)*0.7;
comp_110=`  float vig = 1.0 - 0.55*smoothstep(0.3, 1.1, length(p - float2(0.0, 0.0)));
comp_111=`  float3 bgc = float3(0.020, 0.021, 0.025)*(0.7 + 0.9*exp(-length(p - float2(0.1, 0.0))*2.2) + 0.5*fg);
comp_112=`  float3 flc = float3(0.010, 0.011, 0.014) + float3(0.012, 0.013, 0.017)*exp(-depth*3.0);
comp_113=`  float3 base = lerp(bgc, flc, fl);
comp_114=`  float refl = lerp(1.0, 0.55*exp(-depth*2.0), fl);
comp_115=`  float3 col = base + sc*refl;
comp_116=`  col += float3(0.9, 0.95, 1.0)*exp(-pow((p.y - yf)/0.0035, 2.0))*0.06;
comp_117=`  col *= vig;
comp_118=`  col = 1.0 - exp(-col*1.45);
comp_119=`  ret = col;
comp_120=`}
[PRESET2_END]
