per_frame_init_1=bm=1; bd=0.3; sg=0; tl=0; kf=0; lk=-9; bs=0; ts=0; tr=0; tm2=1; td2=0.3;
per_frame_1=dt = min(max(time-tl,0.004),0.1); tl = time;
per_frame_2=bm = bm + (bass-bm)*(1-exp(-dt/0.8)); bd = bd + (abs(bass-bm)-bd)*(1-exp(-dt/2.5));
per_frame_3=tg = min(max(((bass-bm)/max(bd,0.1) - 0.8)/1.5, 0), 1);
per_frame_4=sg = sg + (tg-sg)*if(above(tg,sg), 1-pow(0.7,60*dt), 1-pow(0.965,60*dt));
per_frame_5=kick = if(band(above(tg,0.5),above(time-lk,0.3)),1,0); lk = if(kick,time,lk);
per_frame_6=kf = max(kick, kf*pow(0.9,60*dt));
per_frame_7=tm2 = tm2 + (treb-tm2)*(1-exp(-dt/0.8)); td2 = td2 + (abs(treb-tm2)-td2)*(1-exp(-dt/2.5));
per_frame_8=ttg = min(max(((treb-tm2)/max(td2,0.15) - 0.8)/1.5, 0), 1);
per_frame_9=tr = tr + (ttg-tr)*if(above(ttg,tr), 1-pow(0.6,60*dt), 1-pow(0.92,60*dt));
per_frame_10=bs = bs + (min(bass,2.5)/2.5-bs)*(1-pow(0.9,60*dt)); ts = ts + dt*(0.6+0.8*sg);
per_frame_11=dsp = 1 + 0.9*bs + 0.5*sg;
per_frame_12=ain = 0.27 + 0.05*sin(time*0.23) + 0.02*sin(time*0.61);
per_frame_13=ey = 0.05 + 0.025*sin(time*0.17) + 0.01*sin(time*0.41);
per_frame_14=ex = (0.5*(ey-0.05)-0.13)/0.866;
per_frame_15=ti = ain + 0.5236; din = -0.5236 + asin(sin(ti)/1.54);
per_frame_16=tq = (0.13 - (0.866*ex+0.5*(ey-0.05)))/(0.866*cos(din)+0.5*sin(din));
per_frame_17=xx = ex + tq*cos(din); xy = ey + tq*sin(din);
per_frame_18=nk = 1.49 + 0.05*dsp*0/7; q1 = 0.5236 + asin(min(max(nk*sin(asin(sin(ti)/nk)-1.0472),-0.985),0.985));
per_frame_19=nk = 1.49 + 0.05*dsp*1/7; q2 = 0.5236 + asin(min(max(nk*sin(asin(sin(ti)/nk)-1.0472),-0.985),0.985));
per_frame_20=nk = 1.49 + 0.05*dsp*2/7; q3 = 0.5236 + asin(min(max(nk*sin(asin(sin(ti)/nk)-1.0472),-0.985),0.985));
per_frame_21=nk = 1.49 + 0.05*dsp*3/7; q4 = 0.5236 + asin(min(max(nk*sin(asin(sin(ti)/nk)-1.0472),-0.985),0.985));
per_frame_22=nk = 1.49 + 0.05*dsp*4/7; q5 = 0.5236 + asin(min(max(nk*sin(asin(sin(ti)/nk)-1.0472),-0.985),0.985));
per_frame_23=nk = 1.49 + 0.05*dsp*5/7; q6 = 0.5236 + asin(min(max(nk*sin(asin(sin(ti)/nk)-1.0472),-0.985),0.985));
per_frame_24=nk = 1.49 + 0.05*dsp*6/7; q7 = 0.5236 + asin(min(max(nk*sin(asin(sin(ti)/nk)-1.0472),-0.985),0.985));
per_frame_25=nk = 1.49 + 0.05*dsp*7/7; q8 = 0.5236 + asin(min(max(nk*sin(asin(sin(ti)/nk)-1.0472),-0.985),0.985));
per_frame_26=q9 = ex; q10 = ey; q11 = xx; q12 = xy; q13 = din; q14 = ain; q15 = sg; q16 = kf; q17 = bs; q18 = ts; q19 = tr;
warp_1=`static float2 PC = float2(0.0, 0.05);
warp_2=`static float yf = -0.21;
warp_3=`float3 spec(float t)
warp_4=`{
warp_5=`  float h = t*0.78;
warp_6=`  return saturate(abs(frac(h + float3(0.0, 0.6667, 0.3333))*6.0 - 3.0) - 1.0);
warp_7=`}
warp_8=`float segd(float2 p, float2 a, float2 b)
warp_9=`{
warp_10=`  float2 pa = p - a;
warp_11=`  float2 ba = b - a;
warp_12=`  float h = saturate(dot(pa, ba)/dot(ba, ba));
warp_13=`  return length(pa - ba*h);
warp_14=`}
warp_15=`float prism(float2 p)
warp_16=`{
warp_17=`  float2 c = p - PC;
warp_18=`  return max(max(-c.y, dot(c, float2(-0.866, 0.5))), dot(c, float2(0.866, 0.5))) - 0.13;
warp_19=`}
warp_20=`float3 light(float2 p, float fogn)
warp_21=`{
warp_22=`  float2 E = float2(q9, q10);
warp_23=`  float2 X = float2(q11, q12);
warp_24=`  float2 dI = float2(cos(q14), sin(q14));
warp_25=`  float pd = prism(p);
warp_26=`  float outside = smoothstep(-0.004, 0.006, pd);
warp_27=`  float fl = 1.0 + 2.4*q16;
warp_28=`  float2 a0 = E - dI*3.0;
warp_29=`  float along = dot(p - E, dI);
warp_30=`  float d1 = segd(p, a0, E);
warp_31=`  float w1 = 0.0065*(1.0 + 0.9*q16);
warp_32=`  float bm1 = exp(-d1*d1/(w1*w1)) + 0.25*exp(-d1*d1/(w1*w1*30.0));
warp_33=`  bm1 *= smoothstep(-1.3, -0.1, along)*(0.5 + 0.9*fogn);
warp_34=`  float3 col = float3(1.0, 0.97, 0.93)*bm1*fl*1.5;
warp_35=`  float d2 = segd(p, E, X);
warp_36=`  float bm2 = exp(-d2*d2/0.00003) + 0.3*exp(-d2*d2/0.0009);
warp_37=`  col += float3(1.0, 0.96, 0.9)*bm2*(1.0 - outside)*1.5*fl;
warp_38=`  float2 v = p - X;
warp_39=`  float dist = length(v);
warp_40=`  float an = atan2(v.y, v.x);
warp_41=`  float th[8];
warp_42=`  th[0] = q1; th[1] = q2; th[2] = q3; th[3] = q4; th[4] = q5; th[5] = q6; th[6] = q7; th[7] = q8;
warp_43=`  float3 fan = float3(0.0, 0.0, 0.0);
warp_44=`  float bavg = 0.0;
warp_45=`  for (int k = 0; k < 8; k++)
warp_46=`  {
warp_47=`    float fk = k*0.142857;
warp_48=`    float bk = saturate(get_fft(0.004 + 0.5*pow(fk, 2.2))*(1.5 + 2.5*fk));
warp_49=`    bavg += bk*0.125;
warp_50=`    float da = clamp(an - th[k], -1.5, 1.5);
warp_51=`    float wk = 0.004*(1.0 + 1.2*bk) + dist*0.006;
warp_52=`    float dp = dist*sin(da);
warp_53=`    fan += spec(fk)*exp(-dp*dp/(wk*wk))*(0.35 + 2.2*bk);
warp_54=`  }
warp_55=`  float s = saturate((an - q1)/(q8 - q1));
warp_56=`  float inr = smoothstep(-0.12, 0.06, (an - q1)/(q8 - q1))*(1.0 - smoothstep(0.94, 1.12, (an - q1)/(q8 - q1)));
warp_57=`  fan += spec(s)*inr*(0.25 + 1.2*bavg)*0.6;
warp_58=`  fan *= exp(-dist*0.5)*smoothstep(0.0, 0.05, dist)*outside*(0.5 + 0.9*fogn);
warp_59=`  col += fan*1.3;
warp_60=`  col += float3(1.0, 0.95, 0.9)*exp(-length(p - E)*28.0)*(0.5 + 1.8*q16);
warp_61=`  col += float3(1.0, 0.9, 0.8)*exp(-dist*22.0)*0.7*outside;
warp_62=`  return col;
warp_63=`}
warp_64=`shader_body
warp_65=`{
warp_66=`  float ar = texsize.x*texsize.w;
warp_67=`  float2 p = float2((uv_orig.x - 0.5)*ar, 0.5 - uv_orig.y);
warp_68=`  float2 nz = tex2D(sampler_noise_mq, p*1.3 + float2(q18*0.03, q18*0.021)).xy - 0.5;
warp_69=`  float fg = tex2D(sampler_noise_lq, p*float2(0.9, 0.9) + float2(-q18*0.012, q18*0.02)).x;
warp_70=`  float2 duv = float2(-0.0004, 0.0006) + nz*0.0016;
warp_71=`  float3 prev = tex2D(sampler_main, uv + duv).xyz;
warp_72=`  float3 L = light(p, fg);
warp_73=`  float3 h = prev*0.935 - 0.0022 + L*0.020;
warp_74=`  ret = saturate(h);
warp_75=`}
