comp_36=`  float bm2 = exp(-d2*d2/0.00003) + 0.3*exp(-d2*d2/0.0009);
comp_37=`  col += float3(1.0, 0.96, 0.9)*bm2*(1.0 - outside)*1.5*fl;
comp_38=`  float2 v = p - X;
comp_39=`  float dist = length(v);
comp_40=`  float an = atan2(v.y, v.x);
comp_41=`  float th[8];
comp_42=`  th[0] = q1; th[1] = q2; th[2] = q3; th[3] = q4; th[4] = q5; th[5] = q6; th[6] = q7; th[7] = q8;
comp_43=`  float3 fan = float3(0.0, 0.0, 0.0);
comp_44=`  float bavg = 0.0;
comp_45=`  for (int k = 0; k < 8; k++)
comp_46=`  {
comp_47=`    float fk = k*0.142857;
comp_48=`    float bk = saturate(get_fft(0.004 + 0.5*pow(fk, 2.2))*(1.5 + 2.5*fk));
comp_49=`    bavg += bk*0.125;
comp_50=`    float da = clamp(an - th[k], -1.5, 1.5);
comp_51=`    float wk = 0.004*(1.0 + 1.2*bk) + dist*0.006;
comp_52=`    float dp = dist*sin(da);
comp_53=`    fan += spec(fk)*exp(-dp*dp/(wk*wk))*(0.35 + 2.2*bk);
comp_54=`  }
comp_55=`  float s = saturate((an - q1)/(q8 - q1));
comp_56=`  float inr = smoothstep(-0.12, 0.06, (an - q1)/(q8 - q1))*(1.0 - smoothstep(0.94, 1.12, (an - q1)/(q8 - q1)));
comp_57=`  fan += spec(s)*inr*(0.25 + 1.2*bavg)*0.6;
comp_58=`  fan *= exp(-dist*0.5)*smoothstep(0.0, 0.05, dist)*outside*(0.5 + 0.9*fogn);
comp_59=`  col += fan*1.3;
comp_60=`  col += float3(1.0, 0.95, 0.9)*exp(-length(p - E)*28.0)*(0.5 + 1.8*q16);
comp_61=`  col += float3(1.0, 0.9, 0.8)*exp(-dist*22.0)*0.7*outside;
