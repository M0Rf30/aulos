shapecode_3_x=0.500000
shapecode_3_y=0.500000
shapecode_3_rad=0.100000
shapecode_3_ang=0.000000
shapecode_3_tex_ang=0.000000
shapecode_3_tex_zoom=1.000000
shapecode_3_r=0.000000
shapecode_3_g=0.000000
shapecode_3_b=0.000000
shapecode_3_a=0.000000
shapecode_3_r2=0.000000
shapecode_3_g2=0.000000
shapecode_3_b2=0.000000
shapecode_3_a2=0.000000
shapecode_3_border_r=0.000000
shapecode_3_border_g=0.000000
shapecode_3_border_b=0.000000
shapecode_3_border_a=0.000000
shape_3_per_frame1=
per_frame_1=dt = min(max(time-tl,0.004),0.1); tl = time; bm = bm + (bass-bm)*(1-exp(-dt/0.8)); bd = bd + (abs(bass-bm)-bd)*(1-exp(-dt/2.5));
per_frame_2=hit = min(max(((bass-bm)/max(bd,0.1) - 0.8)/1.5, 0), 1);
per_frame_3=kick = max(kick*pow(0.88, 60*dt), hit);
per_frame_4=tm = tm + (treb-tm)*(1-exp(-dt/0.8)); td = td + (abs(treb-tm)-td)*(1-exp(-dt/2.5));
per_frame_5=thit = min(max(((treb-tm)/max(td,0.1) - 0.8)/1.5, 0), 1);
per_frame_6=hat = max(hat*pow(0.8, 60*dt), thit);
per_frame_7=sb = sb*pow(0.97,60*dt) + bass_att*(1-pow(0.97,60*dt));
per_frame_8=sm = sm*pow(0.97,60*dt) + mid_att*(1-pow(0.97,60*dt));
per_frame_9=st = st*pow(0.97,60*dt) + treb_att*(1-pow(0.97,60*dt));
per_frame_10=ph = ph + dt*(0.5 + 0.30*sb + 0.9*kick);
per_frame_11=q1 = kick; q2 = ph; q3 = sb; q4 = sm; q5 = st; q6 = hat;
per_frame_12=zoom = 1 + 0.005*kick;
per_frame_13=monitor = kick;
warp_1=`float4 N(float2 x)
warp_2=`{
warp_3=`  return tex2D(sampler_noise_hq, x);
warp_4=`}
warp_5=`float Ps(float2 p, float t)
warp_6=`{
warp_7=`  float a = N(p*0.14 + float2(t*0.012, -t*0.009)).x;
warp_8=`  float b = N(p*0.33 + float2(-t*0.020, t*0.016)).y;
warp_9=`  float c = N(p*0.78 + float2(t*0.031, t*0.027)).z;
warp_10=`  return a + 0.4*b + 0.15*c;
warp_11=`}
warp_12=`shader_body
warp_13=`{
warp_14=`  float ar = texsize.x*texsize.w;
warp_15=`  float2 p = (uv-0.5)*float2(ar,1);
warp_16=`  float t = q2;
warp_17=`  float e = 0.01;
warp_18=`  float px = Ps(p + float2(e,0.0), t) - Ps(p - float2(e,0.0), t);
warp_19=`  float py = Ps(p + float2(0.0,e), t) - Ps(p - float2(0.0,e), t);
warp_20=`  float2 v = float2(py, -px)/(2.0*e);
warp_21=`  float sp = 0.0007*(1.0 + 0.6*q3 + 1.0*q1);
warp_22=`  float2 suv = uv - (v*sp + float2(0.0, 0.0006))*float2(1.0/ar, 1.0);
warp_23=`  float3 prev = tex2D(sampler_main, suv).rgb;
warp_24=`  float3 bl = GetBlur1(suv);
warp_25=`  float3 sh = max(prev + (prev - bl)*0.07, 0.0);
warp_26=`  float seedg = smoothstep(0.86, 0.98, N(p*0.30 + float2(t*0.010, 4.1)).z);
warp_27=`  float seedc = smoothstep(0.86, 0.98, N(p*0.27 + float2(-t*0.012, 9.3)).w);
warp_28=`  sh += float3(1.0,0.62,0.14)*seedg*0.008*(0.6 + q3);
warp_29=`  sh += float3(0.95,0.08,0.20)*seedc*0.008*(0.6 + q3);
warp_30=`  ret = max(sh*float3(0.987, 0.978, 0.968) - 0.0045, 0.0);
warp_31=`}
comp_1=`float4 N(float2 x)
comp_2=`{
comp_3=`  return tex2D(sampler_noise_hq, x);
comp_4=`}
comp_5=`shader_body
comp_6=`{
comp_7=`  float ar = texsize.x*texsize.w;
comp_8=`  float2 p = (uv-0.5)*float2(ar,1);
comp_9=`  float r = length(p);
comp_10=`  float t = q2;
comp_11=`  float2 ca = p/max(r,0.001)*(0.0012 + 0.003*r + 0.002*q1)*float2(1.0/ar,1.0);
comp_12=`  float3 c;
comp_13=`  c.r = tex2D(sampler_main, uv + ca).r;
comp_14=`  c.g = tex2D(sampler_main, uv).g;
comp_15=`  c.b = tex2D(sampler_main, uv - ca).b;
comp_16=`  float3 b1 = GetBlur1(uv);
comp_17=`  float3 b2 = GetBlur2(uv);
comp_18=`  float3 b3 = GetBlur3(uv);
comp_19=`  float lw = dot(c, float3(0.3,0.59,0.11));
comp_20=`  float2 ex = float2(2.0*texsize.z, 0.0);
comp_21=`  float2 ey = float2(0.0, 2.0*texsize.w);
comp_22=`  float gx = dot(GetBlur1(uv+ex) - GetBlur1(uv-ex), float3(0.3,0.59,0.11));
comp_23=`  float gy = dot(GetBlur1(uv+ey) - GetBlur1(uv-ey), float3(0.3,0.59,0.11));
comp_24=`  float3 nm = normalize(float3(-gx*9.0, -gy*9.0, 1.0));
comp_25=`  float3 L = normalize(float3(-0.5, 0.6, 0.65));
comp_26=`  float3 Hv = normalize(L + float3(0.0,0.0,1.0));
comp_27=`  float glint = pow(saturate(dot(nm,Hv)), 30.0)*smoothstep(0.02, 0.25, lw);
comp_28=`  float c1 = N(p*0.30 + float2(t*0.021, t*0.015)).x;
comp_29=`  float c2 = N(p*0.30 + float2(-t*0.017, 5.0 + t*0.012)).y;
comp_30=`  float dd = c1 - c2;
comp_31=`  float cau = exp(-dd*dd*1100.0);
comp_32=`  float c3 = N(p*0.62 + float2(2.0 - t*0.03, t*0.02)).z;
comp_33=`  cau *= (0.3 + 0.7*c3)*(0.6 + 1.6*get_fft(0.03 + 0.45*c3));
comp_34=`  float3 col = c*1.2 + b1*0.30 + b2*0.35 + b3*0.35;
comp_35=`  col = 1.0 - exp(-col*(1.7 + 0.8*q1));
comp_36=`  col += float3(1.0,0.82,0.5)*pow(saturate(lw), 2.5)*0.45;
comp_37=`  col += float3(1.0,0.78,0.45)*glint*0.9;
comp_38=`  float3 bg = float3(0.010,0.020,0.055) + float3(0.020,0.050,0.120)*smoothstep(1.1, 0.0, r);
comp_39=`  bg += float3(0.07,0.25,0.42)*cau*0.5;
comp_40=`  col += bg*(1.0 - saturate(lw*2.0));
comp_41=`  col += float3(1.0,0.7,0.35)*cau*smoothstep(0.05,0.4,lw)*0.25;
comp_42=`  float l = dot(col, float3(0.3,0.59,0.11));
comp_43=`  col = lerp(float3(l,l,l), col, 1.2);
comp_44=`  col *= lerp(0.55, 1.0, smoothstep(1.15, 0.2, r));
comp_45=`  float dn = tex2D(sampler_pw_noise_lq, uv*texsize.xy/256.0).r - 0.5;
comp_46=`  col += dn/160.0;
comp_47=`  ret = saturate(col);
comp_48=`}
[PRESET2_END]
